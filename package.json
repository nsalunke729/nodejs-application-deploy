{
  "name": "node-app-deploy-git-action",
  "version": "1.0.0",
  "description": "Fullstack microservice app deployed via Vercel + GitHub Actions",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm install && npm run build",
    "db:init": "node db/init.js",
    "db:seed": "node db/init.js --seed",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "jest": {
    "transform": {}
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.3",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
